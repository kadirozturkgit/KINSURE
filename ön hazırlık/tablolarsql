TRIGGER TRG_CUSTOMERS_BI
BEFORE INSERT ON CUSTOMERS
FOR EACH ROW
BEGIN
    
    -- Eðer tarih gönderilmediyse anlýk zamaný bas
    IF :NEW.CREATED_AT IS NULL THEN
        :NEW.CREATED_AT := CURRENT_TIMESTAMP;
    END IF;
END;

TRIGGER TRG_CLAIMS_BI
BEFORE INSERT ON CLAIMS
FOR EACH ROW
DECLARE
    v_seq_val      NUMBER;
    v_product_type VARCHAR2(5);
    v_current_year VARCHAR2(4);
    v_count        NUMBER;
BEGIN
    -- 1. POLICY_ID kontrolü: POLICIES tablosunda var mý?
    SELECT COUNT(*) 
    INTO v_count 
    FROM POLICIES 
    WHERE POLICY_ID = :NEW.POLICY_ID;

    IF v_count = 0 THEN
        RAISE_APPLICATION_ERROR(-20001, 'Hata: Girilen POLICY_ID ( ' || :NEW.POLICY_ID || ' ) POLICIES tablosunda bulunamadý!');
    END IF;

    -- 2. Ýlgili poliçenin PRODUCT_TYPE bilgisini al
    SELECT PRODUCT_TYPE 
    INTO v_product_type 
    FROM POLICIES 
    WHERE POLICY_ID = :NEW.POLICY_ID;

    -- 3. CLAIM_ID boþ ise sequence'den sýradaki deðeri al
    IF :NEW.CLAIM_ID IS NULL THEN
        SELECT SEQ_CLAIMS.NEXTVAL INTO v_seq_val FROM DUAL;
        :NEW.CLAIM_ID := v_seq_val;
    ELSE
        v_seq_val := :NEW.CLAIM_ID;
    END IF;

    -- 4. Güncel yýl bilgisini al
    SELECT TO_CHAR(SYSDATE, 'YYYY') INTO v_current_year FROM DUAL;

    -- 5. CLAIM_NO oluþturma kuralý: "Yýl + Boþluk + PRODUCT_TYPE + Boþluk + CLAIM_ID"
    -- Örnek: "2026 K 50000"
    IF :NEW.CLAIM_NO IS NULL THEN
        :NEW.CLAIM_NO := v_current_year || ' ' || v_product_type || ' ' || TO_CHAR(v_seq_val);
    END IF;
END;