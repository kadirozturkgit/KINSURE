-----------TRIGGER TRG_POLICIES_BI
BEFORE INSERT ON POLICIES
FOR EACH ROW
DECLARE
    v_seq_val NUMBER;
BEGIN
    -- 1. POLICY_ID boþ ise sequence'den sýradaki deðeri al
    IF :NEW.POLICY_ID IS NULL THEN
        SELECT SEQ_POLICIES.NEXTVAL INTO v_seq_val FROM DUAL;
        :NEW.POLICY_ID := v_seq_val;
    ELSE
        v_seq_val := :NEW.POLICY_ID;
    END IF;

    -- 2. POLICY_NO boþ gönderildiyse, PRODUCT_TYPE'a göre kuralý uygula
    IF :NEW.POLICY_NO IS NULL THEN
        IF :NEW.PRODUCT_TYPE = 'K' THEN
            -- Kasko için ID + 10000 (Örn: K-20000)
            :NEW.POLICY_NO :=  TO_CHAR(v_seq_val + 10000);
            
        ELSIF :NEW.PRODUCT_TYPE = 'T' THEN
            -- Trafik için ID + 20000
            :NEW.POLICY_NO := TO_CHAR(v_seq_val + 20000);
            
        ELSIF :NEW.PRODUCT_TYPE = 'YE' THEN
            -- Yangýn Endüstriyel için ID + 30000
            :NEW.POLICY_NO :=  TO_CHAR(v_seq_val + 30000);
            
        ELSIF :NEW.PRODUCT_TYPE = 'YB' THEN
            -- Yangýn Bireysel için ID + 40000
            :NEW.POLICY_NO :=  TO_CHAR(v_seq_val + 40000);
            
        ELSIF :NEW.PRODUCT_TYPE = 'KO' THEN
            -- Konut için ID + 90000
            :NEW.POLICY_NO :=TO_CHAR(v_seq_val + 90000);
            
        ELSE
            -- Tanýmlý harici bir tip gelirse varsayýlan
            :NEW.POLICY_NO := 'POL-' || TO_CHAR(v_seq_val);
        END IF;
    END IF;
END;

