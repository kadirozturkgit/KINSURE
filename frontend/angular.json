{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "newProjectRoot": "projects",
  "projects": {
    "kinsure": {
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "configurations": {
            "development": {
              "optimization": false,
              "sourceMap": true
            },
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "800kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "12kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all"
            }
          },
          "defaultConfiguration": "production",
          "options": {
            "assets": [
              {
                "glob": "**/*",
                "input": "../images",
                "output": "assets/images"
              }
            ],
            "browser": "src/main.ts",
            "index": "src/index.html",
            "outputPath": "dist/kinsure",
            "polyfills": [
              "zone.js"
            ],
            "styles": [
              "src/styles.scss"
            ],
            "tsConfig": "tsconfig.app.json"
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "kinsure:build:development"
            },
            "production": {
              "buildTarget": "kinsure:build:production"
            }
          },
          "defaultConfiguration": "development"
        }
      },
      "prefix": "kinsure",
      "projectType": "application",
      "root": "",
      "sourceRoot": "src"
    }
  },
  "version": 1,
  "cli": {
    "analytics": "cf8358c9-077d-4223-b642-c3e3f7410e20"
  }
}
